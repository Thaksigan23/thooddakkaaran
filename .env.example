# Canonical / Open Graph / JSON-LD base (no trailing slash). Defaults in vite.config if unset.
VITE_SITE_URL=https://thooddakkaaran.vercel.app

# Optional: Google Analytics (loaded only after consent on production; never on localhost)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_CONTACT_PHONE=+94 70 000 0000
VITE_CONTACT_EMAIL=info@thooddakkaaran.com
VITE_CONTACT_LOCATION=Mirusuvil, Sri Lanka
VITE_FACTORY_LOCATION=Your Factory Location, Sri Lanka
VITE_FACTORY_MAP_URL=
VITE_WHATSAPP_LINK=https://wa.me/94771234567
# Optional: separate retail e-commerce site (this repo is the official company site only)
VITE_ECOMMERCE_STORE_URL=

# --- Instagram (website + live feed) ---
# Public profile URL for “Follow on Instagram” (include trailing slash if you like)
VITE_INSTAGRAM_PROFILE_URL=https://www.instagram.com/YOUR_USERNAME/

# Optional: full URL to the feed JSON API (only if the site is not served from the same
# origin as /api/instagram — e.g. local dev hitting a deployed Vercel API)
# VITE_INSTAGRAM_FEED_API_URL=https://your-domain.vercel.app/api/instagram

# Server-only (Vercel → Project → Settings → Environment Variables). Never VITE_*.
# Required for automatic posts via Instagram Graph API:
#   INSTAGRAM_ACCESS_TOKEN=
#   INSTAGRAM_BUSINESS_ACCOUNT_ID=
#
# Setup summary (Meta changes details often — search “Instagram Graph API get started”):
#   1) Instagram: switch account to Professional (Business or Creator), link a Facebook Page.
#   2) developers.facebook.com: create an app, add “Instagram” / use Instagram Graph API.
#   3) Generate a long-lived Page access token with permissions to read the linked IG account.
#   4) Find Instagram Business Account ID (Graph API: page → instagram_business_account).
#   5) Put token + ID in Vercel env, redeploy. This repo serves them via api/instagram.js only.
#
# Local: `npm run dev` has no /api route — use `vercel dev`, or set VITE_INSTAGRAM_FEED_API_URL
# to your production /api/instagram URL, or rely on static images until deployed.

# Optional: comma-separated origins allowed to call /api/instagram from the browser cross-origin.
# Same-origin requests do not need this. Example:
# ALLOWED_CORS_ORIGINS=https://thooddakkaaran.vercel.app,https://www.example.com
